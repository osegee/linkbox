// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum OtpPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model User {
  id           String   @id @default(uuid()) 
  fullName     String
  email        String   @unique
  passwordHash String
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  oneTimeCodes  OneTimeCode[]
  collections Collection[]
  links Link[]
  tags Tag[]
}

model RefreshToken {
  id        String    @id @default(uuid()) 
  userId    String     
  familyId  String    @unique
  currentTokenHash  String
  previousTokenHash String?
  deviceId          String
  deviceName        String?
  rotatedAt         DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

model OneTimeCode {
  id         String     @id @default(uuid())
  userId     String     
  purpose    OtpPurpose
  code       String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}
model Collection {
  id          String   @id @default(uuid()) 
  userId      String   
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  links Link[]

  @@unique([userId, name])
  @@index([userId])
}

model Link {
  id           String           @id @default(uuid()) 
  userId       String           
  collectionId String?          
  url          String
  canonicalUrl String?
  title        String?
  description  String?
  imageUrl     String?
  siteName     String?
  domain       String
  status       ProcessingStatus @default(PENDING)
  isFavourite  Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  collection   Collection?   @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  user         User @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkTags     LinkTag[]
  aiEnrichment AiEnrichment?

  @@unique([userId, canonicalUrl])
  @@index([userId, createdAt])
  @@index([userId, collectionId])
  @@index([userId, isFavourite])
  @@index([userId, domain])
}

model Tag {
  id        String   @id @default(uuid()) 
  userId    String   
  name      String
  createdAt DateTime @default(now())

  linkTags LinkTag[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model LinkTag {
  linkId String
  tagId  String

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([linkId, tagId])
  @@index([tagId])
}

model AiEnrichment {
  id        String           @id @default(uuid()) 
  linkId    String           @unique
  summary   String?
  category  String?
  status    ProcessingStatus @default(PENDING)
  model     String?
  error     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  link Link @relation(fields: [linkId], references: [id], onDelete: Cascade)
}